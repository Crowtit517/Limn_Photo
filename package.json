{
  "name": "limn",
  "version": "0.1.1",
  "author": "Crowtit517",
  "description": "Limn - a Photoshop-style photo editor for the desktop (based on miniPaint).",
  "keywords": [
    "photo-editor",
    "image-editor",
    "layers",
    "raw",
    "tauri"
  ],
  "scripts": {
    "start": "node tools/serve.js 8080",
    "server": "webpack serve --mode development --env development --open",
    "dev": "webpack --mode development",
    "build": "webpack --mode production",
    "serve": "webpack serve --mode development --env development --port 8080",
    "app": "node tools/build-app.js && tauri build && node tools/finish-app.js",
    "models": "node tools/get-models.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Crowtit517/Limn_Photo"
  },
  "homepage": "https://github.com/Crowtit517/Limn_Photo",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/plugin-transform-runtime": "^7.14.5",
    "@babel/preset-env": "^7.14.5",
    "@tauri-apps/cli": "^2.12.3",
    "babel-loader": "^8.2.2",
    "css-loader": "^5.2.6",
    "source-map-loader": "^3.0.0",
    "style-loader": "^2.0.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "@babel/runtime": "^7.14.5",
    "@colorhythm/libraw-wasm": "^1.1.1",
    "@huggingface/transformers": "^4.3.1",
    "ag-psd": "^31.0.3",
    "alertifyjs": "^1.13.1",
    "blueimp-canvas-to-blob": "^3.28.0",
    "exif-js": "^2.3.0",
    "file-saver": "^2.0.5",
    "fuzzysort": "^1.1.4",
    "gif.js.optimized": "^1.0.1",
    "hermite-resize": "git+https://github.com/viliusle/Hermite-resize.git",
    "jquery": "^3.5.1",
    "onnxruntime-web": "^1.30.0",
    "pica": "^7.0.0",
    "semver-compare": "^1.0.0",
    "uuid": "^8.3.2",
    "webfontloader": "^1.6.28"
  }
}
